# Backend
DATABASE_URL=postgresql+psycopg2://carsky:carsky@postgres:5432/carsky
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Auto-seed the DB on startup if empty (true/false)
AUTO_SEED=true

# Facebook Marketplace (optional). Path to a Playwright storage_state.json captured by
# `python scripts/fb_login.py` (headed; you complete any 2FA in the browser).
# Leave unset to disable FB; the file is gitignored and mounted read-only by compose.
FB_STORAGE_STATE_PATH=backend/secrets/fb_storage_state.json

# Frontend
# PUBLIC address browsers use to reach the API. Baked into the frontend at BUILD
# time — after changing it, rebuild: docker compose -f docker/docker-compose.yml up -d --build
#  - local:   http://localhost:8000
#  - VPS IP:  http://<YOUR_VPS_IP>:8000
#  - domain:  https://<your-domain>/api  (behind a reverse proxy)
NEXT_PUBLIC_API_URL=http://localhost:8000
