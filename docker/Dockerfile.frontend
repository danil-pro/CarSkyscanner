FROM node:20-alpine
WORKDIR /app
# Baked into the client bundle at build time. Set to the PUBLIC address browsers
# use to reach the API: http://localhost:8000 locally, http://<vps-ip>:8000 or
# https://<domain>/api on a server. Pass via compose build.args.NEXT_PUBLIC_API_URL.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
COPY frontend/package.json ./
RUN npm install
COPY frontend ./
RUN npm run build
EXPOSE 3000
CMD ["npm", "start"]
