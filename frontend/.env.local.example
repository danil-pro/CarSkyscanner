# Browser-facing API URL (host port -> backend container under Docker).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server Components only (Next.js SSR). Under Docker the frontend container
# cannot reach the backend via localhost, so point this at the compose service.
# Leave UNSET for local `next dev` — the public URL already works on the host.
# API_URL_INTERNAL=http://backend:8000
